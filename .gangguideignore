# .gangguideignore
# Ignore rules for the gang.guide pipeline tools.
#
# SYNTAX
# ──────
# Lines starting with '#' are comments. Blank lines are ignored.
#
# SECTIONS
#   [enrich:skip]           — orgs to skip entirely in enrich.py
#   [enrich:skip-field]     — suppress a specific field issue for a specific org
#                             format:  org-id  field
#   [apply:skip-org]        — org IDs that apply.py should never write to
#   [apply:skip-edge]       — edge patterns apply.py should never add
#                             format:  source-org-id  target-org-id  edge-type
#                             use '*' as a wildcard for any field
#   [verify:skip]           — edge patterns that verify.py should skip (treat as supported)
#                             format:  source-org-id  target-org-id  edge-type
#                             use '*' as a wildcard for any field
#   [lint:suppress]         — suppress a specific lint check for a specific org
#                             format:  org-id  check-name
#                             use '*' as org-id to suppress globally
#   [clean:skip]            — orgs to skip entirely in clean.py
#                             use for: verified-clean orgs, tool-limit dead-ends,
#                             orgs with no public data available
#
# ENRICH FIELD NAMES (for enrich:skip-field)
#   no_membership, imprecise_year, no_year, no_symbols, no_aliases,
#   no_colors, stub_desc, short_desc, single_source
#
# LINT CHECK NAMES (for lint:suppress)
#   cross_metro, page_title_org, stub_quality, nation_consistency,
#   spinoff_direction, isolated, temporal_logic, fuzzy_dupe,
#   symbol_title_case, founded_year_precision, single_source
#
# EDGE TYPES (for apply:skip-edge and verify:skip)
#   alliance, rivalry, nation, member_of, spin_off, parent


