org:east-coast-crips-los-angeles  no_membership   # already manually set to 850
org:mob-piru                  no_membership   # already manually set to 200


# ── apply:skip-org ────────────────────────────────────────────────────────────
# Org IDs that apply.py should never overwrite, regardless of pipeline output.
# Use for orgs where the current data is known-correct and pipeline extractions
# are suspected to degrade it (e.g. LLM hallucinations on poorly-sourced pages).
[apply:skip-org]

# (none currently — add orgs here if pipeline keeps corrupting their data)


# ── apply:skip-edge ───────────────────────────────────────────────────────────
# Edge patterns apply.py should never add. Format: source target type
# Use '*' as a wildcard for any single field.
# Useful for permanently rejecting known-bad recurring extractions.
[apply:skip-edge]

# (none currently — add patterns here if a bad edge keeps re-appearing)


# ── verify:skip ───────────────────────────────────────────────────────────────
# Edge patterns verify.py should skip (treat as already supported).
# Use '*' as a wildcard for any single field.
# Useful for well-established relationships that don't need web-checking.
[verify:skip]

